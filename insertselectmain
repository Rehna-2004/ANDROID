package com.example.insertselect;

import androidx.appcompat.app.AlertDialog;
import androidx.appcompat.app.AppCompatActivity;

import android.content.ContentValues;
import android.content.Context;
import android.database.sqlite.SQLiteDatabase;
import android.database.DatabaseUtils;
import android.os.Bundle;
import android.view.View;
import android.widget.Button;
import android.widget.EditText;

public class MainActivity extends AppCompatActivity
        implements View.OnClickListener {

    EditText Rollno, Name, Marks;
    Button Insert, ViewButton, ViewAll;
    SQLiteDatabase db;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main);

        Rollno = findViewById(R.id.Rollno);
        Name = findViewById(R.id.Name);
        Marks = findViewById(R.id.Marks);

        Insert = findViewById(R.id.Insert);
        ViewButton = findViewById(R.id.View);
        ViewAll = findViewById(R.id.ViewAll);

        Insert.setOnClickListener(this);
        ViewButton.setOnClickListener(this);
        ViewAll.setOnClickListener(this);

        db = openOrCreateDatabase(
                "StudentDB", Context.MODE_PRIVATE, null);

        db.execSQL("CREATE TABLE IF NOT EXISTS student (" +
                "rollno VARCHAR PRIMARY KEY, " +
                "name VARCHAR, marks VARCHAR)");
    }

    @Override
    public void onClick(View view) {

        String roll = Rollno.getText().toString().trim();
        String name = Name.getText().toString().trim();
        String marks = Marks.getText().toString().trim();

        if (view == Insert) {

            if (roll.isEmpty() || name.isEmpty()
                    || marks.isEmpty()) {
                showMessage("Error", "Enter all values");
                return;
            }

            ContentValues values = new ContentValues();
            values.put("rollno", roll);
            values.put("name", name);
            values.put("marks", marks);

            long result = db.insert("student", null, values);

            if (result != -1) {
                showMessage("Success", "Record added");
                clearText();
            } else {
                showMessage("Error", "Record not added");
            }
        }

        else if (view == ViewButton) {

            if (roll.isEmpty()) {
                showMessage("Error", "Enter roll number");
                return;
            }

            try {
                String nameResult = DatabaseUtils.stringForQuery(
                        db,
                        "SELECT name FROM student WHERE rollno = ?",
                        new String[]{roll});

                String marksResult = DatabaseUtils.stringForQuery(
                        db,
                        "SELECT marks FROM student WHERE rollno = ?",
                        new String[]{roll});

                Name.setText(nameResult);
                Marks.setText(marksResult);

            } catch (Exception e) {
                showMessage("Error", "Invalid roll number");
            }
        }

        else if (view == ViewAll) {

            String result = DatabaseUtils.stringForQuery(
                    db,
                    "SELECT GROUP_CONCAT(" +
                            "'Roll No: ' || rollno || char(10) || " +
                            "'Name: ' || name || char(10) || " +
                            "'Marks: ' || marks, char(10) || char(10)) " +
                            "FROM student",
                    null);

            if (result == null || result.isEmpty()) {
                showMessage("Error", "No records found");
            } else {
                showMessage("Student Details", result);
            }
        }
    }

    private void clearText() {
        Rollno.setText("");
        Name.setText("");
        Marks.setText("");
        Rollno.requestFocus();
    }

    private void showMessage(String title, String message) {
        new AlertDialog.Builder(this)
                .setTitle(title)
                .setMessage(message)
                .setPositiveButton("OK", null)
                .show();
    }
}
